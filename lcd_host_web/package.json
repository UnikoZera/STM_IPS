{
  "name": "stm-ips-host-desktop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "node electron/run.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 pnpm run electron\"",
    "build": "vite build",
    "start": "pnpm run electron",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "pnpm run build && electron-builder"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "electron": "^40.10.6",
    "svelte": "^5.46.3",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "io.unikozera.stm-ips-host",
    "productName": "STM IPS Host",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "esbuild@0.28.1": true
  }
}
